---
name: release

on:
  push:
    branches:
      - << default_branch >>

permissions: {}

concurrency:
  group: ${{ github.workflow }}-caller-${{ github.ref }}
  cancel-in-progress: false

jobs:
  release:
    uses: hugoh/gh-workflows/.github/workflows/release.yml@<< gh_workflows_ref >>
    permissions:
      contents: write
<% if action %>
    with:
      major-tag: true
<% endif %>
<% if pypi %>

  publish-pypi:
    needs: release
    if: needs.release.outputs.tag != ''
    timeout-minutes: 5
    runs-on: ubuntu-latest
    environment: pypi
    permissions:
      id-token: write
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
          fetch-depth: 0
          ref: ${{ needs.release.outputs.tag }}

      - uses: hugoh/gh-workflows/setup@<< gh_workflows_ref >>

      - name: Build package
        run: uv build

      - name: Publish to PyPI
        uses: pypa/gh-action-pypi-publish@<< pypi_publish_ref >>
        with:
          skip-existing: true
<% endif %>
